<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension point="org.eclipse.ui.views">
      <view
            id="org.eclipse.xterm4eclipse.claude.chat"
            name="Claude Code Chat"
            category="org.eclipse.xterm4eclipse.category"
            class="org.eclipse.xterm4eclipse.claude.ChatView"
            icon="icons/claude.png"
            allowMultiple="true"
            restorable="true"/>
   </extension>
   <extension point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension targetID="*">
         <viewShortcut id="org.eclipse.xterm4eclipse.claude.chat"/>
      </perspectiveExtension>
   </extension>
   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="org.eclipse.xterm4eclipse.claude.preferences"
            name="Claude Code Chat"
            category="org.eclipse.xterm4eclipse.preferences"
            class="org.eclipse.xterm4eclipse.claude.ChatPreferencePage"/>
   </extension>
   <extension point="org.eclipse.ui.commands">
      <category id="org.eclipse.xterm4eclipse.claude.commands" name="Claude Code Chat"/>
      <command
            id="org.eclipse.xterm4eclipse.claude.newChat"
            categoryId="org.eclipse.xterm4eclipse.claude.commands"
            name="New Claude Code Chat"
            description="Opens a chat with Claude Code in the project of the selection"/>
      <command
            id="org.eclipse.xterm4eclipse.claude.resume"
            categoryId="org.eclipse.xterm4eclipse.claude.commands"
            name="Resume a Claude Code Conversation..."
            description="Resumes in a chat a conversation that Claude Code has kept for the project of the selection"/>
      <command
            id="org.eclipse.xterm4eclipse.claude.ask"
            categoryId="org.eclipse.xterm4eclipse.claude.commands"
            name="Ask Claude Code"
            description="Adds the selected lines or files to the message of the last Claude Code chat"/>
   </extension>
   <extension point="org.eclipse.ui.handlers">
      <handler
            commandId="org.eclipse.xterm4eclipse.claude.newChat"
            class="org.eclipse.xterm4eclipse.claude.NewChatHandler"/>
      <handler
            commandId="org.eclipse.xterm4eclipse.claude.resume"
            class="org.eclipse.xterm4eclipse.claude.ResumeHandler"/>
      <handler
            commandId="org.eclipse.xterm4eclipse.claude.ask"
            class="org.eclipse.xterm4eclipse.claude.AskClaudeHandler"/>
   </extension>
   <extension point="org.eclipse.ui.commandImages">
      <image
            commandId="org.eclipse.xterm4eclipse.claude.newChat"
            icon="icons/claude.png"/>
      <image
            commandId="org.eclipse.xterm4eclipse.claude.ask"
            icon="icons/claude.png"/>
   </extension>
   <extension point="org.eclipse.ui.bindings">
      <key
            commandId="org.eclipse.xterm4eclipse.claude.newChat"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+M3+C"/>
      <key
            commandId="org.eclipse.xterm4eclipse.claude.ask"
            contextId="org.eclipse.ui.textEditorScope"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+M2+M3+K"/>
   </extension>
   <extension point="org.eclipse.ui.menus">
      <menuContribution locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               id="org.eclipse.xterm4eclipse.claude.menu"
               label="&amp;Claude">
            <command
                  commandId="org.eclipse.xterm4eclipse.claude.newChat"
                  label="&amp;New Chat"/>
            <command
                  commandId="org.eclipse.xterm4eclipse.claude.resume"
                  label="&amp;Resume a Conversation..."/>
            <command
                  commandId="org.eclipse.xterm4eclipse.claude.ask"
                  label="&amp;Ask Claude Code">
               <visibleWhen checkEnabled="true"/>
            </command>
         </menu>
      </menuContribution>
      <menuContribution locationURI="popup:#AbstractTextEditorContext?after=additions">
         <command
               commandId="org.eclipse.xterm4eclipse.claude.ask">
            <visibleWhen checkEnabled="false">
               <with variable="activeEditorInput">
                  <or>
                     <adapt type="org.eclipse.core.resources.IResource"/>
                     <instanceof value="org.eclipse.ui.IURIEditorInput"/>
                  </or>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="popup:org.eclipse.ui.popup.any?after=additions">
         <command
               commandId="org.eclipse.xterm4eclipse.claude.ask">
            <visibleWhen checkEnabled="false">
               <with variable="selection">
                  <count value="+"/>
                  <iterate ifEmpty="false">
                     <adapt type="org.eclipse.core.resources.IResource"/>
                  </iterate>
               </with>
            </visibleWhen>
         </command>
      </menuContribution>
      <menuContribution locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar id="org.eclipse.xterm4eclipse.claude.toolbar">
            <command
                  commandId="org.eclipse.xterm4eclipse.claude.newChat"
                  style="push"/>
         </toolbar>
      </menuContribution>
   </extension>
</plugin>
